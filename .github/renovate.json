{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":label(dependencies)",
    ":prHourlyLimit2"
  ],
  "description": [
    "Sin automerge: toda actualización pasa por revisión del operador, igual que el resto de cambios del repo.",
    "Se agrupa por gestor y por tipo para reducir el número de PRs sin perder el control."
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "groupName": "npm devDependencies"
    },
    {
      "matchPackagePatterns": ["*"],
      "matchUpdateTypes": ["major"],
      "groupName": "major-updates",
      "addLabels": ["major-update"]
    },
    {
      "matchPackagePatterns": ["*"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "patch-minor"
    }
  ],
  "automerge": false,
  "schedule": ["after 2am on monday"],
  "timezone": "Europe/Madrid",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "branchPrefix": "renovate/",
  "commitMessagePrefix": "chore(deps):",
  "rebaseWhen": "conflicted",
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate Dependency Dashboard"
}
