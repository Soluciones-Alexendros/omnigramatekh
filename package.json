{
  "name": "omnigramatekh",
  "version": "0.2.1",
  "private": true,
  "description": "Vista previa local experimental y planos Archify de OmniGramatekh",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run test:sitio && npm run test:js",
    "test:sitio": "python3 sitio/pruebas/run_checks.py",
    "test:js": "node --test sitio/pruebas/test_menu.js sitio/pruebas/test_a11y.js",
    "test:browser": "npm run test:browser:a11y && npm run test:browser:perf",
    "test:browser:a11y": "node sitio/pruebas/browser/a11y_browser.mjs",
    "test:browser:perf": "lhci autorun --config=sitio/pruebas/browser/lighthouserc.json",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.1",
    "axe-core": "^4.10.0",
    "husky": "^9.1.7",
    "jsdom": "^24.1.0",
    "lint-staged": "^17.6.0",
    "playwright": "1.65.1",
    "prettier": "^3.10.1"
  }
}
