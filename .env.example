# Variables de entorno de ejemplo — omnigramatekh
#
# Estado: plantilla exigida por el perfil P1. Hoy NINGÚN script del repo lee
# estas variables: no hay cargador de .env ni consumidor de configuración.
# Se mantienen documentadas para cuando exista un script que las use; hasta
# entonces, tratarlas como reservadas y no inventar consumidores.
#
# Copia a .env y rellena los valores (NO commitear .env).

# Entorno general
NODE_ENV=development

# LinkML (si algún día se usa una API externa o credenciales)
# LINKML_API_KEY=
# LINKML_ENDPOINT=

# GitHub (para scripts que usen gh CLI o la API)
# GH_TOKEN=

# Utilidades varias
# DEBUG=1
