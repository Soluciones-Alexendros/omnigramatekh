# Variables de entorno de ejemplo — omnigramatekh
# Copia a .env y rellena los valores (NO commitear .env)

# Entorno general
NODE_ENV=development

# LinkML (si se usa API externa o credenciales)
# LINKML_API_KEY=
# LINKML_ENDPOINT=

# GitHub (para scripts que usen gh CLI o API)
# GH_TOKEN=

# Utilidades varias
# DEBUG=1