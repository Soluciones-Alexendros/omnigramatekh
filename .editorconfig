# EditorConfig — https://editorconfig.org
# Prettier es la fuente de verdad del formato; esto cubre a editores y
# herramientas que no pasan por Prettier (Makefile, YAML, configuraciones).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Prettier conserva dos espacios finales como salto de línea en Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.py]
indent_size = 4

[*.sh]
indent_size = 2

[{*.yml,*.yaml}]
indent_size = 2
