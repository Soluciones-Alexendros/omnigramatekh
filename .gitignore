# Local agent and editor state
.cursor/
.claude/
.DS_Store

# Node (Husky / lint-staged)
node_modules/
npm-debug.log*

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Scratch
*.tmp
*.swp

# Evidence runs generated by local `npm test` invocations are not project
# evidence: only curated runs in evidencias/curada/ are versioned.
sitio/pruebas/evidencia/run-*.json
sitio/pruebas/evidencia/latest.json
# Curated evidence (manually promoted) goes here:
!sitio/pruebas/evidencia/curada/

# Archify: se versionan el artefacto (.html) y su fuente (candidate.json).
# Los recibos y pasos intermedios son regenerables y contienen rutas absolutas.
.archify/**/*.browser-check.json
.archify/**/*.delivery.json
.archify/**/*.finalize.json
.archify/**/*.finalize-summary.json
.archify/**/candidate.before-review.json
.archify/**/review-*/